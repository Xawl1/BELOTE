@{
    ViewBag.Title = "Игра Белот";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="belote-game-container">
    <h1>Белот</h1>
    
   
    <div id="biddingStage" class="bidding-stage">
        <h2>Фаза на наддаване</h2>
        <div class="bid-options">
            <button class="btn-bid" data-suit="clubs">♣ Спатия</button>
            <button class="btn-bid" data-suit="diamonds">♦ Каро</button>
            <button class="btn-bid" data-suit="hearts">♥ Купа</button>
            <button class="btn-bid" data-suit="spades">♠ Пика</button>
            <button class="btn-bid" data-suit="notrump">Без коз</button>
            <button class="btn-bid" data-suit="alltrumps">Всичкo коз</button>
            <button class="btn-pass">Пас</button>
        </div>
    </div>
    
    <!-- Игрална маса която е скрита първоначално понеже не успчхме да я направим открита -->
    <div id="gameTable" class="game-table" style="display: none;">
        <!-- Противници -->
        <div class="player-area opponent-top">
            <div class="player-info">
                <span class="player-name">Съотборник</span>
            </div>
            <div class="player-cards horizontal">
                <!-- Картите ще се добавят динамично -->
            </div>
        </div>
        
        <div class="player-area opponent-left">
            <div class="player-info">
                <span class="player-name">Противник</span>
            </div>
            <div class="player-cards vertical">
                <!-- Картите ще се добавят динамично -->
            </div>
        </div>
        
        <div class="player-area opponent-right">
            <div class="player-info">
                <span class="player-name">Противник</span>
            </div>
            <div class="player-cards vertical">
                
            </div>
        </div>
        
        <!-- Център на масата за изиграни карти -->
        <div class="played-cards">
            <div class="card-placeholder" data-position="0"></div>
            <div class="card-placeholder" data-position="1"></div>
            <div class="card-placeholder" data-position="2"></div>
            <div class="card-placeholder" data-position="3"></div>
        </div>
        
        <!-- Текущ играч -->
        <div class="player-area current-player">
            <div class="player-info">
                <span class="player-name">Вие</span>
            </div>
            <div class="player-cards horizontal">
            </div>
        </div>
    </div>
    
    <div class="game-controls">
        <button id="btnPlayCard" class="btn-play-card">Играй избраната карта</button>
        <button id="btnRestartGame" class="btn-restart" style="display: none;">Нова игра</button>
    </div>
    
    <div class="game-info">
        <div class="current-trump">Коз: <span id="currentTrump">Няма</span></div>
        <div class="current-turn">Ход: <span id="currentTurn">Наддаване</span></div>
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function() {
            // Дефиниране на тестето
            const suits = ['hearts', 'diamonds', 'clubs', 'spades'];
            const values = ['7', '8', '9', 'J', 'Q', 'K', '10', 'A'];
            const suitSymbols = {
                'hearts': '♥',
                'diamonds': '♦',
                'clubs': '♣',
                'spades': '♠'
            };
            
            // Стойности и точки на картите за Белот
            const cardValues = {
                '7': { rank: 0, points: 0 },
                '8': { rank: 1, points: 0 },
                '9': { rank: 2, points: 0, trumpRank: 7, trumpPoints: 14 },
                'J': { rank: 3, points: 2, trumpRank: 8, trumpPoints: 20 },
                'Q': { rank: 4, points: 3 },
                'K': { rank: 5, points: 4 },
                '10': { rank: 6, points: 10 },
                'A': { rank: 7, points: 11 }
            };
            
            // Състояние на играта
            var gameState = {
                phase: "bidding",
                currentPlayer: "Вие",
                trump: null,
                bidder: null,
                deck: [],
                playerHand: [],
                opponentsHands: [[], [], []], // [противник-ляво, съотборник-горе, противник-дясно]
                playedCards: [null, null, null, null],
                currentPlayerIndex: 0, // 0=Вие, 1=Противник-ляво, 2=Съотборник-горе, 3=Противник-дясно
                bidPasses: 0,
                teamPoints: 0,
                opponentPoints: 0
            };
            
            // Инициализиране на тестето
            function initializeDeck() {
                gameState.deck = [];
                for (const suit of suits) {
                    for (const value of values) {
                        gameState.deck.push({
                            suit: suit,
                            value: value,
                            symbol: suitSymbols[suit],
                            rank: cardValues[value].rank,
                            points: cardValues[value].points,
                            trumpRank: cardValues[value].trumpRank || cardValues[value].rank,
                            trumpPoints: cardValues[value].trumpPoints || cardValues[value].points
                        });
                    }
                }
            }
            
            // Разбъркване на тестето
            function shuffleDeck() {
                for (let i = gameState.deck.length - 1; i > 0; i--) {
                    const j = Math.floor(Math.random() * (i + 1));
                    [gameState.deck[i], gameState.deck[j]] = [gameState.deck[j], gameState.deck[i]];
                }
            }
            
            // Раздаване на началните 5 карти
            function dealInitialCards() {
                // Раздаване на играча (вас)
                gameState.playerHand = gameState.deck.slice(0, 5);
                
                // Раздаване на противниците
                gameState.opponentsHands[0] = gameState.deck.slice(5, 10);  // Противник-ляво
                gameState.opponentsHands[1] = gameState.deck.slice(10, 15); // Съотборник-горе
                gameState.opponentsHands[2] = gameState.deck.slice(15, 20); // Противник-дясно
                
                // Премахване на раздадените карти от тестето
                gameState.deck = gameState.deck.slice(20);
                
                renderHands();
            }
            
            // Раздаване на останалите 3 карти след наддаване
            function dealRemainingCards() {
                // Раздаване на играча (вас)
                gameState.playerHand = gameState.playerHand.concat(gameState.deck.slice(0, 3));
                
                // Раздаване на противниците
                gameState.opponentsHands[0] = gameState.opponentsHands[0].concat(gameState.deck.slice(3, 6));
                gameState.opponentsHands[1] = gameState.opponentsHands[1].concat(gameState.deck.slice(6, 9));
                gameState.opponentsHands[2] = gameState.opponentsHands[2].concat(gameState.deck.slice(9, 12));
                
                // Сортиране на ръцете с познание за коз
                sortHandWithTrump(gameState.playerHand);
                gameState.opponentsHands.forEach(hand => sortHandWithTrump(hand));
                
                renderHands();
            }
            
            // Сортиране на ръка с познание за коз
            function sortHandWithTrump(hand) {
                const suitOrder = { spades: 0, hearts: 1, diamonds: 2, clubs: 3 };
                hand.sort((a, b) => {
                    // Сортиране на козовите карти първо
                    const aIsTrump = isTrump(a);
                    const bIsTrump = isTrump(b);
                    
                    if (aIsTrump && !bIsTrump) return -1;
                    if (!aIsTrump && bIsTrump) return 1;
                    
                    // Същия козов статус - сортиране по цвят
                    if (suitOrder[a.suit] !== suitOrder[b.suit]) {
                        return suitOrder[a.suit] - suitOrder[b.suit];
                    }
                    
                    // Същия цвят - сортиране по ранг
                    return (aIsTrump ? a.trumpRank : a.rank) - (bIsTrump ? b.trumpRank : b.rank);
                });
            }
            
            // Проверка дали картата е коз
            function isTrump(card) {
                if (!gameState.trump) return false;
                if (gameState.trump === 'Всичко коз') return true;
                if (gameState.trump === 'Без коз') return false;
                return card.suit === gameState.trump;
            }
            
            // Показване на всички ръце
            function renderHands() {
                // Показване на ръката на играча
                const playerHandElement = $('.current-player .player-cards');
                playerHandElement.empty();
                
                gameState.playerHand.forEach((card, index) => {
                    const colorClass = (card.suit === 'hearts' || card.suit === 'diamonds') ? 'red' : 'black';
                    playerHandElement.append(`
                        <div class="card player-card ${colorClass}" data-card-index="${index}">
                            <div class="card-front">
                                <span class="card-value">${card.value}</span>
                                <span class="card-suit">${card.symbol}</span>
                            </div>
                        </div>
                    `);
                });
                
                // Показване на ръцете на противниците (само гърбове)
                $('.opponent-top .player-cards').empty();
                for (let i = 0; i < gameState.opponentsHands[1].length; i++) {
                    $('.opponent-top .player-cards').append('<div class="card opponent-card"></div>');
                }
                
                $('.opponent-left .player-cards').empty();
                for (let i = 0; i < gameState.opponentsHands[0].length; i++) {
                    $('.opponent-left .player-cards').append('<div class="card opponent-card"></div>');
                }
                
                $('.opponent-right .player-cards').empty();
                for (let i = 0; i < gameState.opponentsHands[2].length; i++) {
                    $('.opponent-right .player-cards').append('<div class="card opponent-card"></div>');
                }
            }
            
            // Показване на изиграните карти в центъра
            function renderPlayedCards() {
                $('.card-placeholder').empty();
                
                gameState.playedCards.forEach((card, index) => {
                    if (card) {
                        const colorClass = (card.suit === 'hearts' || card.suit === 'diamonds') ? 'red' : 'black';
                        $(`.card-placeholder[data-position="${index}"]`).html(`
                            <div class="card played-card ${colorClass}" style="transform: rotate(${(index-1)*5}deg);">
                                <div class="card-front">
                                    <span class="card-value">${card.value}</span>
                                    <span class="card-suit">${card.symbol}</span>
                                </div>
                            </div>
                        `);
                    }
                });
            }
            
            // ИИ играе карта
            function aiPlayCard(playerIndex) {
                if (gameState.phase !== "playing") return;
                
                const hand = gameState.opponentsHands[playerIndex - 1]; // Коригиране на индекса за масива
                if (hand.length === 0) return;
                
                // Опростен ИИ - играе първата карта в ръката
                const cardIndex = 0;
                const card = hand[cardIndex];
                
                // Игране на картата (добавяне в центъра)
                gameState.playedCards[playerIndex] = card;
                renderPlayedCards();
                
                // Премахване от ръката
                hand.splice(cardIndex, 1);
                
                // Следващ ход
                nextTurn();
            }
            
            // Преминаване към хода на следващия играч
            function nextTurn() {
                // Намаляване на currentPlayerIndex за ходове обратно на часовниковата стрелка
                gameState.currentPlayerIndex = (gameState.currentPlayerIndex - 1 + 4) % 4;

                const players = ["Вие", "Противник-ляво", "Съотборник", "Противник-дясно"];
                gameState.currentPlayer = players[gameState.currentPlayerIndex];
                $('#currentTurn').text(gameState.currentPlayer);

                // Прерисуване на ръцете
                renderHands();

                // Ако взятката е завършена (всички 4 играчи са играли)
                if (gameState.playedCards.every(card => card !== null)) {
                    evaluateTrick();
                    return;
                }

                // Ако е ход на ИИ играч, той играе
                if (gameState.currentPlayerIndex !== 0) {
                    setTimeout(() => aiPlayCard(gameState.currentPlayerIndex), 1000);
                }
            }
            
            // Оценка на завършената взятка
            function evaluateTrick() {
                const winningCard = getWinningCard();
                const winningPlayerIndex = gameState.playedCards.indexOf(winningCard);
                const winningPlayer = ["Вие", "Противник", "Съотборник", "Противник"][winningPlayerIndex];
                
                // Изчисляване на точките във взятката
                const trickPoints = calculateTrickPoints();
                
                // Добавяне на точки към съответния отбор
                if (winningPlayerIndex === 0 || winningPlayerIndex === 2) {
                    // Вашият отбор (вие и съотборник) спечели
                    gameState.teamPoints += trickPoints;
                } else {
                    // Противниците спечелиха
                    gameState.opponentPoints += trickPoints;
                }
                
                // Показване кой спечели 
                $('#currentTurn').text(`${winningPlayer} спечели взятката (${trickPoints} т.)`);
                
                // Изчистване на изиграните карти за следващата взятка
                gameState.playedCards = [null, null, null, null];
                gameState.currentPlayerIndex = winningPlayerIndex;
                gameState.currentPlayer = winningPlayer;
                
                // Проверка дали рундът е завършен (всички карти изиграни)
                if (gameState.playerHand.length === 0 && 
                    gameState.opponentsHands.every(hand => hand.length === 0)) {
                    endRound();
                } else {
                    // Продължаване към следващата взятка
                    setTimeout(() => {
                        renderPlayedCards();
                        $('#currentTurn').text(gameState.currentPlayer);
                        if (gameState.currentPlayerIndex !== 0) {
                            setTimeout(() => aiPlayCard(gameState.currentPlayerIndex), 1000);
                        }
                    }, 2000);
                }
            }
            
            // Определяне на печелившата карта във взятката
            function getWinningCard() {
                const leadSuit = gameState.playedCards[0].suit;
                let winningCard = gameState.playedCards[0];
                let highestRank = isTrump(winningCard) ? winningCard.trumpRank : winningCard.rank;
                
                for (let i = 1; i < gameState.playedCards.length; i++) {
                    const card = gameState.playedCards[i];
                    let currentRank;
                    
                    if (isTrump(card)) {
                        currentRank = card.trumpRank;
                        // Ако текущата печеливша карта не е коз, тази печели
                        if (!isTrump(winningCard)) {
                            winningCard = card;
                            highestRank = currentRank;
                        } else if (currentRank > highestRank) {
                            winningCard = card;
                            highestRank = currentRank;
                        }
                    } else if (card.suit === leadSuit && !isTrump(winningCard)) {
                        currentRank = card.rank;
                        if (currentRank > highestRank) {
                            winningCard = card;
                            highestRank = currentRank;
                        }
                    }
                }
                
                return winningCard;
            }
            
            // Изчисляване на точките в текущата взятка
            function calculateTrickPoints() {
                return gameState.playedCards.reduce((total, card) => {
                    return total + (isTrump(card) ? card.trumpPoints : card.points);
                }, 0);
            }
            
            // Край на рунда
            function endRound() {
                // Определяне дали наддаващият отбор е изпълнил договора
                const biddingTeam = (gameState.bidder === 0 || gameState.bidder === 2) ? "your" : "opponent";
                const biddingTeamPoints = (gameState.bidder === 0 || gameState.bidder === 2) ? 
                    gameState.teamPoints : gameState.opponentPoints;
                
                let message;
                if (biddingTeam === "your") {
                    if (biddingTeamPoints >= 82) {
                        message = "Вашият отбор изпълни договора!";
                    } else {
                        message = "Вашият отбор не изпълни договора! Противниците получават всички точки.";
                        gameState.opponentPoints = 162;
                    }
                } else {
                    if (biddingTeamPoints >= 82) {
                        message = "Противниците изпълниха договора си!";
                    } else {
                        message = "Противниците не изпълниха договора! Вашият отбор получава всички точки.";
                        gameState.teamPoints = 162;
                    }
                }
                
                $('#currentTurn').text(`Край на рунда! ${message} (Вашият отбор: ${gameState.teamPoints} - Противници: ${gameState.opponentPoints})`);
                $('#btnPlayCard').hide();
                $('#btnRestartGame').show();
            }
            
            // Инициализиране на играта (раздаване на начални 5 карти)
            function initializeGame() {
                initializeDeck();
                shuffleDeck();
                dealInitialCards();
                gameState.bidPasses = 0;
                gameState.phase = "bidding";
                $('#currentTurn').text("Наддаване - Вашият ход");
                $('#biddingStage').show();
                $('#gameTable').hide();
                $('#btnPlayCard').show();
                $('#btnRestartGame').hide();
            }
            
            // Обработчици за фазата на наддаване
            $('.btn-bid').click(function() {
                var suit = $(this).data('suit');
                gameState.trump = suit;
                gameState.bidder = 0; // Играчът е наддаващият
                
                // Раздаване на останалите карти и стартиране на играта
                dealRemainingCards();
                endBiddingPhase();
            });
            
            $('.btn-pass').click(function() {
                gameState.bidPasses++;
                
                if (gameState.bidPasses >= 4) {
                    // Всички играчи пасуват - прераздаване
                    alert("Всички играчи пасуват. Прераздаване на карти...");
                    initializeGame();
                    return;
                }
                
                // ИИ противниците правят своите наддавания
                setTimeout(function() {
                    // Опростен ИИ - 30% шанс да наддаде
                    if (Math.random() < 0.3) {
                        const suits = ['clubs', 'diamonds', 'hearts', 'spades', 'notrump', 'alltrumps'];
                        gameState.trump = suits[Math.floor(Math.random() * suits.length)];
                        gameState.bidder = gameState.bidPasses + 1; // Следващият играч е наддаващият
                        
                        // Раздаване на останалите карти и стартиране на играта
                        dealRemainingCards();
                        endBiddingPhase();
                    } else {
                        // ИИ пасува
                        gameState.bidPasses++;
                        if (gameState.bidPasses >= 4) {
                            alert("Всички играчи пасуват. Прераздаване на карти...");
                            initializeGame();
                        } else {
                            alert(`Играч ${gameState.bidPasses} пасува. Чака се следващ играч...`);
                        }
                    }
                }, 1000);
            });
            
            function endBiddingPhase() {
                $('#biddingStage').hide();
                $('#gameTable').show();
                $('#currentTrump').text(gameState.trump);
                $('#currentTurn').text(gameState.currentPlayer);
                gameState.phase = "playing";
                gameState.currentPlayerIndex = gameState.bidder;
                gameState.currentPlayer = ["Вие", "Противник", "Съотборник", "Противник"][gameState.bidder];
                
                // Ако наддаващият не е играчът, започва ход на ИИ
                if (gameState.currentPlayerIndex !== 0) {
                    setTimeout(() => aiPlayCard(gameState.currentPlayerIndex), 1000);
                }
            }
            
            // Обработчици за фазата на игра
            $(document).on('click', '.player-card', function() {
                if (gameState.phase !== "playing") return;
                if (gameState.currentPlayerIndex !== 0) return; // Позволено само когато е ход на играча
                
                if ($(this).hasClass('selected')) {
                    $(this).removeClass('selected');
                } else {
                    $('.player-card').removeClass('selected');
                    $(this).addClass('selected');
                }
            });
            
            $('#btnPlayCard').click(function() {
                if (gameState.phase !== "playing") {
                    alert("Все още е фаза на наддаване!");
                    return;
                }

                if (gameState.currentPlayerIndex !== 0) {
                    alert("Не е вашият ход!");
                    return;
                }

                const selectedCard = $('.player-card.selected');
                if (selectedCard.length) {
                    const cardIndex = selectedCard.data('card-index');
                    const card = gameState.playerHand[cardIndex];

                    // Прилагане на правилото: трябва да се играе карта от същия цвят като първата карта, ако е възможно
                    const leadCard = gameState.playedCards.find(c => c !== null); // Първа карта във взятката
                    if (leadCard) {
                        const leadSuit = leadCard.suit;
                        const hasMatchingSuit = gameState.playerHand.some(c => c.suit === leadSuit);

                        if (hasMatchingSuit && card.suit !== leadSuit) {
                            alert(`Трябва да играете карта от ${leadSuit} цвят, ако имате такава.`);
                            return;
                        }
                    }

                    // Игране на картата (добавяне в центъра)
                    gameState.playedCards[gameState.currentPlayerIndex] = card;
                    renderPlayedCards();

                    // Премахване от ръката
                    gameState.playerHand.splice(cardIndex, 1);

                    // Преминаване към хода на следващия играч
                    nextTurn();
                } else {
                    alert('Моля изберете карта за игра');
                }
            });
            
            // Обработчик за нова игра
            $('#btnRestartGame').click(function() {
                initializeGame();
            });
            
            // Стартиране на играта
            initializeGame();
        });
    </script>
}

<style>
    .belote-game-container {
        max-width: 1400px;
        margin: 0 auto;
        font-family: Arial, sans-serif;
    }
    
    /* Bidding stage styles */
    .bidding-stage {
        background-color: #f8f9fa;
        padding: 20px;
        border-radius: 10px;
        margin-bottom: 20px;
        text-align: center;
    }
    
    .bid-options {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 10px;
        margin: 20px 0;
    }
    
    .btn-bid, .btn-pass {
        padding: 12px 20px;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        font-size: 16px;
        font-weight: bold;
        transition: all 0.3s;
    }
    
    .btn-bid {
        background-color: #007bff;
        color: white;
    }
    
    .btn-bid:hover {
        background-color: #0069d9;
    }
    
    .btn-bid[data-suit="clubs"] { background-color: #343a40; }
    .btn-bid[data-suit="diamonds"] { background-color: #dc3545; }
    .btn-bid[data-suit="hearts"] { background-color: #dc3545; }
    .btn-bid[data-suit="spades"] { background-color: #343a40; }
    .btn-bid[data-suit="notrump"] { background-color: #6c757d; }
    .btn-bid[data-suit="alltrumps"] { background-color: #28a745; }
    
    .btn-pass {
        background-color: #ffc107;
        color: #212529;
    }
    
    .btn-pass:hover {
        background-color: #e0a800;
    }
    
    /* Game table styles */
    .game-table {
        position: relative;
        height: 800px;
        width: 100%;
        background-color: #2a6d2a;
        border-radius: 10px;
        padding: 30px;
        margin-bottom: 20px;
    }
    
    .player-area {
        position: absolute;
    }
    
    .opponent-top {
        top: 30px;
        left: 50%;
        transform: translateX(-50%);
    }
    
    .opponent-left {
        top: 50%;
        left: 20px;
        transform: translateY(-50%);
    }
    
    .opponent-right {
        top: 50%;
        right: 20px;
        transform: translateY(-50%);
    }
    
    .current-player {
        bottom: 30px;
        left: 50%;
        transform: translateX(-50%);
    }
    
