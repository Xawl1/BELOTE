@{
    ViewBag.Title = "Belote Card Game";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="belote-game-container">
    <h1>Belote</h1>
    
    <!-- Bidding Stage (visible initially) -->
    <div id="biddingStage" class="bidding-stage">
        <h2>Bidding Phase</h2>
        <div class="bid-options">
            <button class="btn-bid" data-suit="clubs">♣ Clubs</button>
            <button class="btn-bid" data-suit="diamonds">♦ Diamonds</button>
            <button class="btn-bid" data-suit="hearts">♥ Hearts</button>
            <button class="btn-bid" data-suit="spades">♠ Spades</button>
            <button class="btn-bid" data-suit="notrump">No Trump</button>
            <button class="btn-bid" data-suit="alltrumps">All Trumps</button>
            <button class="btn-pass">Pass</button>
        </div>
    </div>
    
    <!-- Main Game Table (hidden initially) -->
    <div id="gameTable" class="game-table" style="display: none;">
        <!-- Opponent players -->
        <div class="player-area opponent-top">
            <div class="player-info">
                <span class="player-name">Teammate</span>
            </div>
            <div class="player-cards horizontal">
                <!-- Cards will be added dynamically -->
            </div>
        </div>
        
        <div class="player-area opponent-left">
            <div class="player-info">
                <span class="player-name">Opponent</span>
            </div>
            <div class="player-cards vertical">
                <!-- Cards will be added dynamically -->
            </div>
        </div>
        
        <div class="player-area opponent-right">
            <div class="player-info">
                <span class="player-name">Opponent</span>
            </div>
            <div class="player-cards vertical">
                <!-- Cards will be added dynamically -->
            </div>
        </div>
        
        <!-- Center of the table for played cards -->
        <div class="played-cards">
            <div class="card-placeholder" data-position="0"></div>
            <div class="card-placeholder" data-position="1"></div>
            <div class="card-placeholder" data-position="2"></div>
            <div class="card-placeholder" data-position="3"></div>
        </div>
        
        <!-- Current player -->
        <div class="player-area current-player">
            <div class="player-info">
                <span class="player-name">You</span>
            </div>
            <div class="player-cards horizontal">
                <!-- Cards will be added dynamically -->
            </div>
        </div>
    </div>
    
    <div class="game-controls">
        <button id="btnPlayCard" class="btn-play-card">Play Selected Card</button>
        <button id="btnRestartGame" class="btn-restart" style="display: none;">Restart Game</button>
    </div>
    
    <div class="game-info">
        <div class="current-trump">Trump: <span id="currentTrump">None</span></div>
        <div class="current-turn">Current turn: <span id="currentTurn">Bidding</span></div>
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function() {
            // Card deck definition
            const suits = ['hearts', 'diamonds', 'clubs', 'spades'];
            const values = ['7', '8', '9', 'J', 'Q', 'K', '10', 'A'];
            const suitSymbols = {
                'hearts': '♥',
                'diamonds': '♦',
                'clubs': '♣',
                'spades': '♠'
            };
            
            // Card values and points for Belote
            const cardValues = {
                '7': { rank: 0, points: 0 },
                '8': { rank: 1, points: 0 },
                '9': { rank: 2, points: 0, trumpRank: 7, trumpPoints: 14 },
                'J': { rank: 3, points: 2, trumpRank: 8, trumpPoints: 20 },
                'Q': { rank: 4, points: 3 },
                'K': { rank: 5, points: 4 },
                '10': { rank: 6, points: 10 },
                'A': { rank: 7, points: 11 }
            };
            
            // Game state
            var gameState = {
                phase: "bidding",
                currentPlayer: "You",
                trump: null,
                bidder: null,
                deck: [],
                playerHand: [],
                opponentsHands: [[], [], []], // [opponent-left, teammate-top, opponent-right]
                playedCards: [null, null, null, null],
                currentPlayerIndex: 0, // 0=You, 1=Opponent-left, 2=Teammate-top, 3=Opponent-right
                bidPasses: 0,
                teamPoints: 0,
                opponentPoints: 0
            };
            
            // Initialize deck
            function initializeDeck() {
                gameState.deck = [];
                for (const suit of suits) {
                    for (const value of values) {
                        gameState.deck.push({
                            suit: suit,
                            value: value,
                            symbol: suitSymbols[suit],
                            rank: cardValues[value].rank,
                            points: cardValues[value].points,
                            trumpRank: cardValues[value].trumpRank || cardValues[value].rank,
                            trumpPoints: cardValues[value].trumpPoints || cardValues[value].points
                        });
                    }
                }
            }
            
            // Shuffle deck
            function shuffleDeck() {
                for (let i = gameState.deck.length - 1; i > 0; i--) {
                    const j = Math.floor(Math.random() * (i + 1));
                    [gameState.deck[i], gameState.deck[j]] = [gameState.deck[j], gameState.deck[i]];
                }
            }
            
            // Deal initial 5 cards to each player
            function dealInitialCards() {
                // Deal to player (you)
                gameState.playerHand = gameState.deck.slice(0, 5);
                
                // Deal to opponents
                gameState.opponentsHands[0] = gameState.deck.slice(5, 10);  // Opponent-left
                gameState.opponentsHands[1] = gameState.deck.slice(10, 15); // Teammate-top
                gameState.opponentsHands[2] = gameState.deck.slice(15, 20); // Opponent-right
                
                // Remove dealt cards from deck
                gameState.deck = gameState.deck.slice(20);
                
                renderHands();
            }
            
            // Deal remaining 3 cards after bidding
            function dealRemainingCards() {
                // Deal to player (you)
                gameState.playerHand = gameState.playerHand.concat(gameState.deck.slice(0, 3));
                
                // Deal to opponents
                gameState.opponentsHands[0] = gameState.opponentsHands[0].concat(gameState.deck.slice(3, 6));
                gameState.opponentsHands[1] = gameState.opponentsHands[1].concat(gameState.deck.slice(6, 9));
                gameState.opponentsHands[2] = gameState.opponentsHands[2].concat(gameState.deck.slice(9, 12));
                
                // Sort hands with trump knowledge
                sortHandWithTrump(gameState.playerHand);
                gameState.opponentsHands.forEach(hand => sortHandWithTrump(hand));
                
                renderHands();
            }
            
            // Sort hand with trump knowledge
            function sortHandWithTrump(hand) {
                const suitOrder = { spades: 0, hearts: 1, diamonds: 2, clubs: 3 };
                hand.sort((a, b) => {
                    // Sort trumps first
                    const aIsTrump = isTrump(a);
                    const bIsTrump = isTrump(b);
                    
                    if (aIsTrump && !bIsTrump) return -1;
                    if (!aIsTrump && bIsTrump) return 1;
                    
                    // Same trump status - sort by suit
                    if (suitOrder[a.suit] !== suitOrder[b.suit]) {
                        return suitOrder[a.suit] - suitOrder[b.suit];
                    }
                    
                    // Same suit - sort by rank
                    return (aIsTrump ? a.trumpRank : a.rank) - (bIsTrump ? b.trumpRank : b.rank);
                });
            }
            
            // Check if card is trump
            function isTrump(card) {
                if (!gameState.trump) return false;
                if (gameState.trump === 'alltrumps') return true;
                if (gameState.trump === 'notrump') return false;
                return card.suit === gameState.trump;
            }
            
            // Render all hands
            function renderHands() {
                // Render player's hand
                const playerHandElement = $('.current-player .player-cards');
                playerHandElement.empty();
                
                gameState.playerHand.forEach((card, index) => {
                    const colorClass = (card.suit === 'hearts' || card.suit === 'diamonds') ? 'red' : 'black';
                    playerHandElement.append(`
                        <div class="card player-card ${colorClass}" data-card-index="${index}">
                            <div class="card-front">
                                <span class="card-value">${card.value}</span>
                                <span class="card-suit">${card.symbol}</span>
                            </div>
                        </div>
                    `);
                });
                
                // Render opponents' hands (just back of cards)
                $('.opponent-top .player-cards').empty();
                for (let i = 0; i < gameState.opponentsHands[1].length; i++) {
                    $('.opponent-top .player-cards').append('<div class="card opponent-card"></div>');
                }
                
                $('.opponent-left .player-cards').empty();
                for (let i = 0; i < gameState.opponentsHands[0].length; i++) {
                    $('.opponent-left .player-cards').append('<div class="card opponent-card"></div>');
                }
                
                $('.opponent-right .player-cards').empty();
                for (let i = 0; i < gameState.opponentsHands[2].length; i++) {
                    $('.opponent-right .player-cards').append('<div class="card opponent-card"></div>');
                }
            }
            
            // Render played cards in center
            function renderPlayedCards() {
                $('.card-placeholder').empty();
                
                gameState.playedCards.forEach((card, index) => {
                    if (card) {
                        const colorClass = (card.suit === 'hearts' || card.suit === 'diamonds') ? 'red' : 'black';
                        $(`.card-placeholder[data-position="${index}"]`).html(`
                            <div class="card played-card ${colorClass}" style="transform: rotate(${(index-1)*5}deg);">
                                <div class="card-front">
                                    <span class="card-value">${card.value}</span>
                                    <span class="card-suit">${card.symbol}</span>
                                </div>
                            </div>
                        `);
                    }
                });
            }
            
            // AI plays a card
            function aiPlayCard(playerIndex) {
                if (gameState.phase !== "playing") return;
                
                const hand = gameState.opponentsHands[playerIndex - 1]; // Adjust index for array
                if (hand.length === 0) return;
                
                // Simple AI - play first card in hand
                const cardIndex = 0;
                const card = hand[cardIndex];
                
                // Play the card (add to center)
                gameState.playedCards[playerIndex] = card;
                renderPlayedCards();
                
                // Remove from hand
                hand.splice(cardIndex, 1);
                
                // Update turn
                nextTurn();
            }
            
            // Move to next player's turn
            function nextTurn() {
                gameState.currentPlayerIndex = (gameState.currentPlayerIndex + 1) % 4;
                const players = ["You", "Opponent", "Teammate", "Opponent"];
                gameState.currentPlayer = players[gameState.currentPlayerIndex];
                $('#currentTurn').text(gameState.currentPlayer);
                
                // Re-render hands
                renderHands();
                
                // If trick is complete (all 4 players played)
                if (gameState.playedCards.every(card => card !== null)) {
                    evaluateTrick();
                    return;
                }
                
                // If it's an AI player's turn, have them play
                if (gameState.currentPlayerIndex !== 0) {
                    setTimeout(() => aiPlayCard(gameState.currentPlayerIndex), 1000);
                }
            }
            
            // Evaluate the completed trick
            function evaluateTrick() {
                const winningCard = getWinningCard();
                const winningPlayerIndex = gameState.playedCards.indexOf(winningCard);
                const winningPlayer = ["You", "Opponent", "Teammate", "Opponent"][winningPlayerIndex];
                
                // Calculate points in trick
                const trickPoints = calculateTrickPoints();
                
                // Add points to appropriate team
                if (winningPlayerIndex === 0 || winningPlayerIndex === 2) {
                    // Your team (you and teammate) won
                    gameState.teamPoints += trickPoints;
                } else {
                    // Opponents won
                    gameState.opponentPoints += trickPoints;
                }
                
                // Show who won the trick
                $('#currentTurn').text(`${winningPlayer} wins the trick (${trickPoints} pts)`);
                
                // Clear played cards for next trick
                gameState.playedCards = [null, null, null, null];
                gameState.currentPlayerIndex = winningPlayerIndex;
                gameState.currentPlayer = winningPlayer;
                
                // Check if round is over (all cards played)
                if (gameState.playerHand.length === 0 && 
                    gameState.opponentsHands.every(hand => hand.length === 0)) {
                    endRound();
                } else {
                    // Continue to next trick
                    setTimeout(() => {
                        renderPlayedCards();
                        $('#currentTurn').text(gameState.currentPlayer);
                        if (gameState.currentPlayerIndex !== 0) {
                            setTimeout(() => aiPlayCard(gameState.currentPlayerIndex), 1000);
                        }
                    }, 2000);
                }
            }
            
            // Determine the winning card in the trick
            function getWinningCard() {
                const leadSuit = gameState.playedCards[0].suit;
                let winningCard = gameState.playedCards[0];
                let highestRank = isTrump(winningCard) ? winningCard.trumpRank : winningCard.rank;
                
                for (let i = 1; i < gameState.playedCards.length; i++) {
                    const card = gameState.playedCards[i];
                    let currentRank;
                    
                    if (isTrump(card)) {
                        currentRank = card.trumpRank;
                        // If current winning card isn't trump, this one wins
                        if (!isTrump(winningCard)) {
                            winningCard = card;
                            highestRank = currentRank;
                        } else if (currentRank > highestRank) {
                            winningCard = card;
                            highestRank = currentRank;
                        }
                    } else if (card.suit === leadSuit && !isTrump(winningCard)) {
                        currentRank = card.rank;
                        if (currentRank > highestRank) {
                            winningCard = card;
                            highestRank = currentRank;
                        }
                    }
                }
                
                return winningCard;
            }
            
            // Calculate points in the current trick
            function calculateTrickPoints() {
                return gameState.playedCards.reduce((total, card) => {
                    return total + (isTrump(card) ? card.trumpPoints : card.points);
                }, 0);
            }
            
            // End of round processing
            function endRound() {
                // Determine if bidding team made their contract
                const biddingTeam = (gameState.bidder === 0 || gameState.bidder === 2) ? "your" : "opponent";
                const biddingTeamPoints = (gameState.bidder === 0 || gameState.bidder === 2) ? 
                    gameState.teamPoints : gameState.opponentPoints;
                
                let message;
                if (biddingTeam === "your") {
                    if (biddingTeamPoints >= 82) {
                        message = "Your team made the contract!";
                    } else {
                        message = "Your team failed the contract! Opponents get all points.";
                        gameState.opponentPoints = 162;
                    }
                } else {
                    if (biddingTeamPoints >= 82) {
                        message = "Opponents made their contract!";
                    } else {
                        message = "Opponents failed their contract! Your team gets all points.";
                        gameState.teamPoints = 162;
                    }
                }
                
                $('#currentTurn').text(`Round over! ${message} (Your team: ${gameState.teamPoints} - Opponents: ${gameState.opponentPoints})`);
                $('#btnPlayCard').hide();
                $('#btnRestartGame').show();
            }
            
            // Initialize game (deal initial 5 cards)
            function initializeGame() {
                initializeDeck();
                shuffleDeck();
                dealInitialCards();
                gameState.bidPasses = 0;
                gameState.phase = "bidding";
                $('#currentTurn').text("Bidding - Your turn");
                $('#biddingStage').show();
                $('#gameTable').hide();
                $('#btnPlayCard').show();
                $('#btnRestartGame').hide();
            }
            
            // Bidding phase handlers
            $('.btn-bid').click(function() {
                var suit = $(this).data('suit');
                gameState.trump = suit;
                gameState.bidder = 0; // Player is the bidder
                
                // Deal remaining cards and start game
                dealRemainingCards();
                endBiddingPhase();
            });
            
            $('.btn-pass').click(function() {
                gameState.bidPasses++;
                
                if (gameState.bidPasses >= 4) {
                    // All players passed - redeal
                    alert("All players passed. Redealing cards...");
                    initializeGame();
                    return;
                }
                
                // AI opponents take their turns to bid
                setTimeout(function() {
                    // Simple AI - 30% chance to bid
                    if (Math.random() < 0.3) {
                        const suits = ['clubs', 'diamonds', 'hearts', 'spades', 'notrump', 'alltrumps'];
                        gameState.trump = suits[Math.floor(Math.random() * suits.length)];
                        gameState.bidder = gameState.bidPasses + 1; // Next player is bidder
                        
                        // Deal remaining cards and start game
                        dealRemainingCards();
                        endBiddingPhase();
                    } else {
                        // AI passes
                        gameState.bidPasses++;
                        if (gameState.bidPasses >= 4) {
                            alert("All players passed. Redealing cards...");
                            initializeGame();
                        } else {
                            alert(`Player ${gameState.bidPasses} passed. Waiting for next player...`);
                        }
                    }
                }, 1000);
            });
            
            function endBiddingPhase() {
                $('#biddingStage').hide();
                $('#gameTable').show();
                $('#currentTrump').text(gameState.trump);
                $('#currentTurn').text(gameState.currentPlayer);
                gameState.phase = "playing";
                gameState.currentPlayerIndex = gameState.bidder;
                gameState.currentPlayer = ["You", "Opponent", "Teammate", "Opponent"][gameState.bidder];
                
                // If bidder is not player, start AI turn
                if (gameState.currentPlayerIndex !== 0) {
                    setTimeout(() => aiPlayCard(gameState.currentPlayerIndex), 1000);
                }
            }
            
            // Card play phase handlers
            $(document).on('click', '.player-card', function() {
                if (gameState.phase !== "playing") return;
                if (gameState.currentPlayerIndex !== 0) return; // Only allow when it's player's turn
                
                if ($(this).hasClass('selected')) {
                    $(this).removeClass('selected');
                } else {
                    $('.player-card').removeClass('selected');
                    $(this).addClass('selected');
                }
            });
            
            $('#btnPlayCard').click(function() {
                if (gameState.phase !== "playing") {
                    alert("Bidding phase still in progress!");
                    return;
                }
                
                if (gameState.currentPlayerIndex !== 0) {
                    alert("It's not your turn!");
                    return;
                }
                
                const selectedCard = $('.player-card.selected');
                if (selectedCard.length) {
                    const cardIndex = selectedCard.data('card-index');
                    const card = gameState.playerHand[cardIndex];
                    
                    // Play the card (add to center)
                    gameState.playedCards[gameState.currentPlayerIndex] = card;
                    renderPlayedCards();
                    
                    // Remove from hand
                    gameState.playerHand.splice(cardIndex, 1);
                    
                    // Move to next player's turn
                    nextTurn();
                } else {
                    alert('Please select a card to play');
                }
            });
            
            // Restart game handler
            $('#btnRestartGame').click(function() {
                initializeGame();
            });
            
            // Start the game
            initializeGame();
        });
    </script>
}

<style>
    .belote-game-container {
        max-width: 1400px;
        margin: 0 auto;
        font-family: Arial, sans-serif;
    }
    
    /* Bidding stage styles */
    .bidding-stage {
        background-color: #f8f9fa;
        padding: 20px;
        border-radius: 10px;
        margin-bottom: 20px;
        text-align: center;
    }
    
    .bid-options {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 10px;
        margin: 20px 0;
    }
    
    .btn-bid, .btn-pass {
        padding: 12px 20px;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        font-size: 16px;
        font-weight: bold;
        transition: all 0.3s;
    }
    
    .btn-bid {
        background-color: #007bff;
        color: white;
    }
    
    .btn-bid:hover {
        background-color: #0069d9;
    }
    
    .btn-bid[data-suit="clubs"] { background-color: #343a40; }
    .btn-bid[data-suit="diamonds"] { background-color: #dc3545; }
    .btn-bid[data-suit="hearts"] { background-color: #dc3545; }
    .btn-bid[data-suit="spades"] { background-color: #343a40; }
    .btn-bid[data-suit="notrump"] { background-color: #6c757d; }
    .btn-bid[data-suit="alltrumps"] { background-color: #28a745; }
    
    .btn-pass {
        background-color: #ffc107;
        color: #212529;
    }
    
    .btn-pass:hover {
        background-color: #e0a800;
    }
    
    /* Game table styles */
    .game-table {
        position: relative;
        height: 800px;
        width: 100%;
        background-color: #2a6d2a;
        border-radius: 10px;
        padding: 30px;
        margin-bottom: 20px;
    }
    
    .player-area {
        position: absolute;
    }
    
    .opponent-top {
        top: 30px;
        left: 50%;
        transform: translateX(-50%);
    }
    
    .opponent-left {
        top: 50%;
        left: 20px;
        transform: translateY(-50%);
    }
    
    .opponent-right {
        top: 50%;
        right: 20px;
        transform: translateY(-50%);
    }
    
    .current-player {
        bottom: 30px;
        left: 50%;
        transform: translateX(-50%);
    }
    
    .player-info {
        text-align: center;
        color: white;
        margin-bottom: 15px;
        font-size: 18px;
    }
    
    .player-cards {
        display: flex;
    }
    
    .player-cards.horizontal {
        flex-direction: row;
        flex-wrap: wrap;
        justify-content: center;
        max-width: 800px;
    }
    
    .player-cards.vertical {
        flex-direction: column;
        align-items: center;
        max-height: 500px;
        overflow: hidden;
    }
    
    .player-cards.vertical .card {
        margin: 2px 0;
    }
    
    .card {
        width: 90px;
        height: 130px;
        background-color: white;
        border-radius: 6px;
        margin: 0 5px;
        position: relative;
        box-shadow: 2px 2px 5px rgba(0,0,0,0.3);
    }
    
    .card.red {
        color: #d40000;
    }
    
    .card.black {
        color: #222;
    }
    
    .opponent-card {
        background-color: #ddd;
    }
    
    .player-card {
        cursor: pointer;
        transition: transform 0.2s;
    }
    
    .player-card:hover {
        transform: translateY(-10px);
    }
    
    .player-card.selected {
        transform: translateY(-20px);
        box-shadow: 0 0 15px gold;
    }
    
    .played-card {
        position: relative;
        box-shadow: 0 0 10px rgba(255,255,255,0.7);
    }
    
    .card-front {
        position: absolute;
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: 8px;
    }
    
    .card-value {
        font-size: 22px;
        font-weight: bold;
    }
    
    .card-suit {
        font-size: 30px;
    }
    
    .played-cards {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        display: flex;
        gap: 30px;
    }
    
    .card-placeholder {
        width: 100px;
        height: 140px;
        display: flex;
        justify-content: center;
        align-items: center;
    }
    
    .game-controls {
        text-align: center;
        margin-bottom: 20px;
    }
    
    .btn-play-card {
        padding: 15px 40px;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        background-color: #28a745;
        color: white;
        font-size: 20px;
        font-weight: bold;
        transition: background-color 0.3s;
    }
    
    .btn-play-card:hover {
        background-color: #218838;
    }
    
    .btn-restart {
        padding: 15px 40px;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        background-color: #dc3545;
        color: white;
        font-size: 20px;
        font-weight: bold;
        transition: background-color 0.3s;
        margin-left: 20px;
    }
    
    .btn-restart:hover {
        background-color: #c82333;
    }
    
    .game-info {
        display: flex;
        justify-content: center;
        gap: 40px;
        font-size: 20px;
        font-weight: bold;
    }
    
    /* Team colors */
    .opponent-top .player-info {
        color: #4cc9f0; /* Blue for teammate */
    }
    
    .opponent-left .player-info,
    .opponent-right .player-info {
        color: #ff6b6b; /* Red for opponents */
    }
</style>